# Скопируйте этот файл в backend/.env и впишите ключи. .env в git не попадает, ключи остаются только на сервере.

# ---------- ElevenLabs: «мозг» (LLM через Agents Platform), голос (TTS) и распознавание речи (Scribe) ----------
ELEVENLABS_API_KEY=
# Модели «мозга» (поле llm агента ElevenLabs). Меняются и в интерфейсе: баланс → AI providers.
ELEVENLABS_LLM=claude-sonnet-4-5
ELEVENLABS_LLM_FAST=gemini-2.5-flash
# ID агента-оркестратора. Пусто — создаётся автоматически при первом вызове и запоминается в БД.
ELEVENLABS_BRAIN_AGENT_ID=
ELEVENLABS_BRAIN_TIMEOUT_SEC=300
# Голос по умолчанию (Rachel) и пул голосов монстров через запятую (пусто — встроенный список готовых голосов)
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_POOL=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
SPEECH_MAX_CHARS=280

# ---------- Запасные «мозги» (необязательно) ----------
# LLM_PROVIDER: elevenlabs | sokosumi | openai (пусто — выбирается по наличию ключей)
LLM_PROVIDER=
SOKOSUMI_API_KEY=
SOKOSUMI_AGENT_ID=
SOKOSUMI_API_URL=https://api.sokosumi.com/v1
SOKOSUMI_JOB_TIMEOUT_SEC=900
SOKOSUMI_BUDGET_CREDITS=5000
CREDIT_USD=0.01
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=

# ---------- Безопасность ----------
# Если задан — все /api требуют заголовок X-Frank-Token (интерфейс спросит токен один раз).
APP_ACCESS_TOKEN=
# Разрешить органы с доступом в интернет. В monster-lab это нужно: погода, веб-поиск, чтение страниц.
# Без этого монстр-шаблон (погода) не ставится, и вопрос уходит в LLM.
ALLOW_NETWORK_CAPABILITIES=true
MAX_UPLOAD_MB=25
# Read-only source of already learned skills/knowledge from the original backend.
FRANK_IMPORT_DATA_DIR=

# ---------- Песочница ----------
SANDBOX_MODE=auto
SANDBOX_TIMEOUT_SEC=60
SANDBOX_MEMORY_MB=512

# ---------- Правила цикла ----------
MAX_REPAIRS=3
MAX_WORKFLOW_ATTEMPTS=3
MIN_TESTS=8

# Проверенные шаблоны органов (собеседования, погода): 1 — ставить из шаблона без генерации кода, 0 — всегда генерировать моделью
FRANK_USE_TEMPLATES=1

# Кэш проверенных ответов модели (часы; 0 — без срока)
FRANK_LLM_CACHE_TTL_HOURS=168
# Бюджет токенов на задачу: обычная / со сборкой органа (0 — без ограничения)
FRANK_MAX_TOKENS_PER_TASK=40000
FRANK_MAX_TOKENS_PER_BUILD=150000
# Звуки монстров и сцена рождения (ElevenLabs Sound Effects + Text to Dialogue; генерируются один раз). 0 — выключить
FRANK_THEATRICS=1
# Browser WebAudio effects remain enabled in the UI. Generated birth/SFX audio is
# optional; final-answer speech uses Friend's regular ElevenLabs verdict pipeline.
FRANK_LAB_GENERATED_AUDIO=0
FRANK_LAB_TYPED_TTS=1
FRANK_LAB_SPEECH_MODEL=eleven_v3
FRANK_LAB_SPEECH_MAX_CHARS=900
# explicit: Sokosumi only after a direct request / Research button; automatic: also for current/latest/market hints
FRANK_LAB_RESEARCH_MODE=explicit
# Use the configured fast model for routine planning/composing; builds and repairs still use the strong model.
FRANK_LAB_FAST_RESPONSES=1
# FRANK_VOICE_FRANKENSTEIN=onwK4e9ZLuTAKqWW03F9
# FRANK_VOICE_IGOR=N2lVS1w4EtoT3dr4eOWO

# Свежие знания через Sokosumi (платно -> только после подтверждения в интерфейсе); нужен SOKOSUMI_API_KEY выше
# Агент-исследователь (подобрать: tools/sokosumi_probe.py). В проекте коллеги использовался веб-исследователь
# cmmtavwps000w04kyxr9tngxy (поле research_question) — проверьте, что он доступен вашему ключу.
SOKOSUMI_RESEARCH_AGENT_ID=
SOKOSUMI_MAX_CREDITS_PER_JOB=300
SOKOSUMI_DAILY_CREDIT_CAP=1000
FRANK_RESEARCH_FRESH_DAYS=30
